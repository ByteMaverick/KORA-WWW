# Copy this to .env in the repo root and fill in the first block. The rest are the paper's defaults and can stay.
# Anything set in the shell wins over this file. A commented-out line means "keep the default".


# ---- 1. you have to set these ----------------------------------------------------------------------------------

# the model, on any OpenAI-compatible server (vLLM, or a hosted API)
KORA_LLM_BASE_URL=http://localhost:8000/v1
# the model id that server serves; the paper used Qwen3-30B-A3B-Instruct-2507
KORA_LLM_MODEL=model-name
# a local server takes any key; a hosted API needs the real one
OPENAI_API_KEY=EMPTY

# the graph: Freebase in Virtuoso (WebQSP, CWQ, GrailQA) ...
FREEBASE_SPARQL_URL=http://localhost:8890/sparql
# ... and/or MetaQA in Neo4j; data/README.md says how to load both
NEO4J_METAQA_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=korakora


# ---- 2. the two local servers (these match the README's start commands) ----------------------------------------

# the embedder (bge-small), used to rank relations:  python -m kora.embed_server --port 8001
KORA_EMBED_BASE_URL=http://localhost:8001/v1
KORA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# the Stopping Estimator:  python -m estimator.server --checkpoint <downloaded folder> --port 8100
ESTIMATOR_URL=http://localhost:8100


# ---- 3. KORA's defaults, as in the paper. Touch these only for ablations. ----------------------------------------

# who stops the run: estimator (the paper's KORA) | llm (the model judges) | gold (the gold answers; a ceiling, needs --gold)
# only `kora answer` reads this. The harness takes --stop and refuses to run while this is set, so keep it
# commented and do `KORA_STOP=llm python -m kora answer ...` for a one-off.
# KORA_STOP=estimator

# budget per question. The harness pins these to the paper's values; `kora answer` reads them from here.
KORA_SECONDS=140
KORA_TOKENS=400000

# query rounds per task
KORA_ROUNDS=2

# how the question gets split when nothing is accepted: from the plan's constraints
KORA_DECOMPOSER=structural

# how an operation picks the property it reads (filter / count / superlative): model | match. Default model.
# Same story as KORA_STOP: the harness refuses it, so keep it commented unless you run `kora answer` ablations.
# KORA_PROPERTY=model

# what a run that runs out of budget answers with: best (its best candidate) | held (nothing).
# KORA_STOP already sets this (estimator: best; llm and gold: held).
# KORA_CLOCK_FALLBACK=best

# the estimator's cut on P(yes); unset = whatever the server reads from its checkpoint (0.0494)
# ESTIMATOR_TAU=

# parallel probes against Freebase
# KORA_PROBE_WORKERS=8

# where embeddings are cached (default artifacts/embeddings)
# KORA_EMBED_CACHE_DIR=artifacts/embeddings

# reasoning effort for gpt-oss / o-series models: low | medium | high. The paper ran gpt-oss at low.
# KORA_REASONING=low

# for reference, what the three stop modes set underneath:
#   estimator   KORA_ROOT_JUDGE=judge      KORA_JUDGE_IMPL=estimator  KORA_CLOCK_FALLBACK=best
#   llm         KORA_ROOT_JUDGE=knowledge  KORA_JUDGE_IMPL=llm        KORA_CLOCK_FALLBACK=held
#   gold        KORA_ROOT_JUDGE=oracle     KORA_ORACLE=strict         KORA_JUDGE_IMPL=llm   KORA_CLOCK_FALLBACK=held
# and the knobs that live in the code rather than here:
#   seed relations per round 6      kora/modules/query/seeds.py     PAGE_SEEDS
#   generated candidates 4          kora/modules/query/generate.py  GENERATED
#   relations kept per ranking 50   kora/modules/query/models.py    K_RELATIONS
#   anchors per task 5              kora/modules/query/models.py    MAX_ANCHORS
#   neighbourhood lines shown 120   kora/modules/query/search.py    MAX_LINES
#   parallel tasks 4                kora/agents/controller.py       Controller(parallel=4)


# ---- 4. the harness: python -m harness run | score | compare ---------------------------------------------------

# every system talks to the one model above (or --api-base / --model); --stop picks who stops a run

# seconds per question. `score` counts anything over 200 s as a miss, which is the paper's limit.
HARNESS_TIMEOUT=200

# the extractor that turns Direct LLM's prose answers into a list when scoring; the paper used the same
# Qwen3-30B-A3B-Instruct-2507 at temperature 0
EXTRACTOR_BASE_URL=http://localhost:8000/v1
EXTRACTOR_MODEL=model-name

# the Neo4j database the baselines read MetaQA from; the paper's graph sits in neo4j, the server's default
NEO4J_METAQA_DATABASE=neo4j

# the graph-call log under each run's traces/ (graph-trace support is computed from it); 0 turns it off
# HARNESS_GRAPH_LOG=1
# warn on stderr each time one process's log grows past this many GB
# HARNESS_GRAPH_LOG_ALERT_GB=5

# PoG's sentence model, used when a relation has more than 70 entities to rank
# POG_SENTENCE_MODEL=sentence-transformers/msmarco-distilbert-base-tas-b

# reasoning effort every system sends to gpt-oss, instead of the settings table's low; local experiments only
# LLM_REASONING_EFFORT=low

# KB-BINDER's data folder, filled by `bash baselines/kbbinder/fetch.sh` (default baselines/kbbinder/data)
# KBB_DATA=baselines/kbbinder/data
